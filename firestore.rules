rules_version = '2';

// ────────────────────────────────────────────────────────────────────────────
// SSOT for the shared comment Firebase project: prototype-comments-27106
//
// 這個 Firebase project 只存「設計審查留言」，由本 repo 的 pc.js 寫入，
// 被嵌在 vitallink / coshift / badminton 等各 prototype 頁面（全部指向同一個 project）。
// 留言規則只該住在這裡這一份，不要再 copy 進各 consumer 的 firestore.rules。
//
// Deploy（會自動套到 .firebaserc 的 default project = prototype-comments-27106）：
//   firebase deploy --only firestore:rules
//   # 或   make deploy-rules
// ────────────────────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    // 任何已登入且 email 已驗證的 Google 帳號都能寫入（不再限 @jubo.health）。
    // 仍要求登入 + email_verified，擋掉完全匿名灌留言；作者本人才能改/刪自己的留言。
    function isSignedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    // 設計審查留言。Read 公開（分享連結即可看），寫入限已登入帳號。
    // 作者本人可改全部欄位；其他登入同事只能改白名單欄位（協作型、非破壞性）：
    //   resolved + resolvedBy/resolvedByUid/resolvedAt = 收尾歸屬（pc.js resolve 一次寫這四欄）
    //   reactions                                       = 表情
    //   decision / decisionNote                         = 採用 / 不採用決議
    // reviewer 通常不是留言作者，故放行這些欄位讓任何同事可 resolve / 取消解決。
    //
    // ⚠ 白名單必須與 src/index.js 的 resolvePayload() 寫入欄位同步：
    //   改 pc.js 寫入欄位時，這份白名單要一起改，然後 `make deploy-rules`。
    match /prototype-comments/{projectId}/comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() &&
        (request.auth.uid == resource.data.authorUid ||
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['resolved', 'resolvedBy', 'resolvedByUid', 'resolvedAt',
                     'reactions', 'decision', 'decisionNote']));
      allow delete: if isSignedIn() &&
        request.auth.uid == resource.data.authorUid;
    }

    // ────────────────────────────────────────────────────────────────────────
    // 終端使用者回饋（src/user-feedback.js）。
    //
    // 與上面的設計審查留言是**兩種不同的東西**，刻意分開存：
    //   comments      給同事，要登入，可協作 resolve，read 公開。
    //   user-feedback 給產品的真實使用者（醫師、客戶），**免登入**——
    //                 要他們先登入才留言，回饋率會掉。
    //
    // 免登入的代價由這三件事擋住，缺一不可：
    //   1. 只能 create。read/update/delete 全關，連寫的人自己都讀不回來，
    //      所以它不會變成一個公開留言板，也沒有爬取價值。
    //   2. 欄位白名單 + 長度上限（圖片 700 KB，留在單文件 1 MiB 之內）。
    //   3. 本機 bridge 用 Google 服務憑證讀取（繞過 rules），所以不必開 read。
    //
    // ⚠ 因此這個 collection **不得存放敏感或個人資料**。
    // ⚠ 欄位白名單要與 src/user-feedback.js 的 send() 寫入欄位同步。
    function hasValidFeedbackShape() {
      let note = request.resource.data;
      return note.keys().hasOnly([
          'page', 'selector', 'elementText', 'note',
          'image', 'reporter', 'createdAt', 'status'
        ]) &&
        note.status == 'new' &&
        note.note is string && note.note.size() > 0 && note.note.size() <= 2000 &&
        note.image is string && note.image.size() <= 700000 &&
        note.page is string && note.page.size() <= 200 &&
        note.selector is string && note.selector.size() <= 500 &&
        note.elementText is string && note.elementText.size() <= 200 &&
        note.reporter is string && note.reporter.size() <= 50 &&
        note.createdAt is string && note.createdAt.size() <= 40;
    }

    match /user-feedback/{projectId}/notes/{noteId} {
      allow create: if hasValidFeedbackShape();
      allow read, update, delete: if false;
    }
  }
}
